---
layout: layouts/page.njk
title: "Help us"
permalink: /en/contact/
langAlternate: "/contact/"
description: "Join Notre Demain as a volunteer, partner or donor to help Haitian youth."
---
<div class="container" style="max-width: 52rem;">
  <header style="margin-block-end: var(--space-10);">
    <p class="eyebrow">Act together</p>
    <h1>Help us</h1>
    <p style="font-size: var(--text-lg);">You can join us as a volunteer, partner or simply send us a message of encouragement.</p>
  </header>

  <form
    name="contact-en"
    method="POST"
    action="/en/thank-you/"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="contact-form stack"
    novalidate
  >
    <input type="hidden" name="form-name" value="contact-en">
    <p class="hidden" aria-hidden="true"><label>Do not fill: <input name="bot-field"></label></p>

    <div class="grid grid--2">
      <div class="form-field">
        <label for="name">Name <span aria-label="required">*</span></label>
        <input type="text" id="name" name="name" required autocomplete="name">
      </div>
      <div class="form-field">
        <label for="email">Email address <span aria-label="required">*</span></label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>
    </div>

    <div class="form-field">
      <label for="role">How would you like to help?</label>
      <select id="role" name="role">
        <option value="">— Choose —</option>
        <option value="benevole">Volunteer</option>
        <option value="partenaire">Partner / Organization</option>
        <option value="donateur">Donor</option>
        <option value="autre">Other</option>
      </select>
    </div>

    <div class="form-field">
      <label for="message">Message <span aria-label="required">*</span></label>
      <textarea id="message" name="message" required></textarea>
    </div>

    <div class="form-field">
      <label style="display: flex; gap: var(--space-3); align-items: flex-start; font-weight: 400; cursor: pointer;">
        <input type="checkbox" name="consent" required style="width: auto; margin-top: 0.2em;">
        <span>I agree that my data will be used only to respond to my message, in accordance with the <a href="/en/privacy/">privacy policy</a>. <span aria-label="required">*</span></span>
      </label>
    </div>

    <p class="form-error" hidden>An error occurred. Please try again or write directly to <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>

    <button type="submit" class="btn btn--primary">Send message</button>
  </form>

  <p style="margin-top: var(--space-8); font-size: var(--text-sm); color: color-mix(in srgb, var(--color-ink) 65%, transparent);">
    You can also write to us directly at <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
  </p>
</div>

<script src="/assets/js/contact-form-en.js" defer></script>
