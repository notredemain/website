---
layout: layouts/base.njk
ogType: Event
---
<article class="activity-single">

  {% if cover %}
  <div class="activity-single__cover">
    {% image cover, coverAlt, "100vw", [800, 1200, 1600, 2000], "eager", "high" %}
  </div>
  {% endif %}

  <div class="page-wrapper{% if upcoming %} page-wrapper--compact{% endif %}">
    <header class="activity-single__header container">
      <p class="eyebrow">Activité</p>
      <h1>{{ title }}</h1>
      {% if summary %}<p class="activity-single__summary">{{ summary }}</p>{% endif %}
      <dl class="activity-single__meta">
        {% if date %}<div><dt>Date</dt><dd>{{ date | dateFR }}{% if endDate %} → {{ endDate | dateFR }}{% endif %}</dd></div>{% endif %}
        {% if location %}<div><dt>Lieu</dt><dd>{{ location }}</dd></div>{% endif %}
      </dl>
    </header>

    {% if stats and stats.length %}
    <section class="stats-band" aria-label="Chiffres clés">
      <ul class="stats-band__list">
        {% for stat in stats %}
        <li class="stats-band__item">
          <span class="stats-band__value">{{ stat.value }}</span>
          <span class="stats-band__label">{{ stat.label }}</span>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if upcoming %}
    <div class="upcoming-banner container">
      <p>🗓 Cette activité est en cours de préparation. Revenez bientôt pour en savoir plus.</p>
    </div>
    {% endif %}

    {% if content | trim %}
    <div class="activity-single__body prose container">
      {{ content | safe }}
    </div>
    {% endif %}

    {% if partners and partners.length %}
    <aside class="activity-single__partners container">
      <p class="eyebrow">Partenaires</p>
      <ul class="partners-list">
        {% for partner in partners %}
        <li class="partners-list__item">
          {% if partner.url %}<a href="{{ partner.url }}" rel="noopener noreferrer" target="_blank">{{ partner.name }}</a>{% else %}{{ partner.name }}{% endif %}
        </li>
        {% endfor %}
      </ul>
    </aside>
    {% endif %}
  </div>

  {% if gallery and gallery.length %}
  <section class="gallery container" aria-label="Galerie photos">
    <h2>Galerie</h2>
    <ul class="gallery__grid">
      {% for photo in gallery %}
      <li class="gallery__item">
        {% image photo.src, photo.alt, "(min-width: 60em) 33vw, (min-width: 40em) 50vw, 100vw", [400, 800, 1200] %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% include "partials/cta-help.njk" %}
</article>
